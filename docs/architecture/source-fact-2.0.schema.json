{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "start_line",
        "end_line"
      ],
      "title": "Citation",
      "type": "object"
    },
    "SemanticSymbol": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alias"
        },
        "binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "constructor": {
          "default": false,
          "title": "Constructor",
          "type": "boolean"
        },
        "default_export": {
          "default": false,
          "title": "Default Export",
          "type": "boolean"
        },
        "dispatch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispatch"
        },
        "end_byte": {
          "minimum": 0,
          "title": "End Byte",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "exported": {
          "default": false,
          "title": "Exported",
          "type": "boolean"
        },
        "file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "import_module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Import Module"
        },
        "imported_member": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imported Member"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "local_binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Binding"
        },
        "parameters": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "qualified_name": {
          "title": "Qualified Name",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "start_byte": {
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "type_only": {
          "default": false,
          "title": "Type Only",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "start_line",
        "end_line",
        "start_byte",
        "end_byte",
        "category",
        "language",
        "source_name",
        "qualified_name"
      ],
      "title": "SemanticSymbol",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "category": {
      "enum": [
        "syntax",
        "relationship",
        "entrypoint"
      ],
      "title": "Category",
      "type": "string"
    },
    "classification": {
      "enum": [
        "declared",
        "resolved_static",
        "unresolved",
        "inferred"
      ],
      "title": "Classification",
      "type": "string"
    },
    "commit_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "entrypoint_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entrypoint Category"
    },
    "entrypoint_target": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entrypoint Target"
    },
    "parser_rules": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Parser Rules",
      "type": "array"
    },
    "relationship": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relationship"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Repository",
      "type": "string"
    },
    "schema_version": {
      "const": "source-fact-2.0",
      "default": "source-fact-2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/SemanticSymbol"
    },
    "support": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "minItems": 1,
      "title": "Support",
      "type": "array"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticSymbol"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "repository",
    "commit_sha",
    "category",
    "subject",
    "classification",
    "support",
    "parser_rules"
  ],
  "title": "CanonicalFact",
  "type": "object"
}
