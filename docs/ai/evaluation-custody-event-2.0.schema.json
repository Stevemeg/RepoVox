{
  "$id": "https://repovox.invalid/contracts/evaluation-custody-event-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "engineering_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Engineering Commit",
      "type": "string"
    },
    "identity_basis": {
      "enum": [
        "owner_attested",
        "synthetic_fixture"
      ],
      "title": "Identity Basis",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "previous_event_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Event Sha256"
    },
    "provider_authenticated": {
      "const": false,
      "default": false,
      "title": "Provider Authenticated",
      "type": "boolean"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": "evaluation-custody-event-2.0",
      "default": "evaluation-custody-event-2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scope Sha256",
      "type": "string"
    },
    "scorer_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Scorer Commit",
      "type": "string"
    },
    "sequence": {
      "maximum": 7,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "session_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "trusted_context": {
      "minLength": 1,
      "title": "Trusted Context",
      "type": "string"
    }
  },
  "required": [
    "engineering_commit",
    "identity_basis",
    "kind",
    "payload_sha256",
    "previous_event_sha256",
    "recorded_at",
    "schema_version",
    "scope_sha256",
    "scorer_commit",
    "sequence",
    "session_id",
    "tenant_id",
    "trusted_context"
  ],
  "title": "Event",
  "type": "object"
}
