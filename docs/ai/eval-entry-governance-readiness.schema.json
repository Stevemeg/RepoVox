          "family_id": {"const": "stevemeg-ai-job-agent"}, "repository": {"const": "stevemeg/ai-job-agent"},
          "commit_sha": {"const": "e5cb0dfe1c79e7ba75a4a1416f7b25b5ce46ac8f"}, "preliminary_language": {"const": "mixed"},
          "declared_license": {"const": "MIT"}, "declared_license_sha256": {"const": "93cc3a570eca0f8493aa63c9965c6cea278456073bbfbdef5715d7976cc7b39f"}
        }}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["family_id", "repository", "commit_sha", "preliminary_language", "declared_license", "declared_license_sha256"], "properties": {
          "family_id": {"const": "stevemeg-enterprise-llm-gateway"}, "repository": {"const": "stevemeg/enterprise-llm-gateway"},
          "commit_sha": {"const": "bd67a36767c86329b3641d49146d306ea5254c83"}, "preliminary_language": {"const": "python"},
          "declared_license": {"const": "MIT"}, "declared_license_sha256": {"const": "3f3bbdfb7cdd88ae2f600c586c7158d2f276ea1cca26519c44be3dd04c58c30f"}
        }}, "minContains": 1, "maxContains": 1}
      ],
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family_id", "repository", "commit_sha", "preliminary_language", "declared_license", "declared_license_sha256", "status", "evidence_scope", "official_admission_authorized", "unresolved_rights_and_provenance"],
        "properties": {
          "family_id": {"$ref": "#/$defs/text"}, "repository": {"$ref": "#/$defs/text"},
          "commit_sha": {"$ref": "#/$defs/git_sha"},
          "preliminary_language": {"enum": ["python", "javascript_typescript", "mixed"]},
          "declared_license": {"$ref": "#/$defs/text"}, "declared_license_sha256": {"$ref": "#/$defs/sha256"},
          "status": {"const": "UNVERIFIED"}, "evidence_scope": {"const": "EXISTING_CATALOG_METADATA_ONLY"},
          "official_admission_authorized": {"const": false}, "unresolved_rights_and_provenance": {"$ref": "#/$defs/text"}
        }
      }
    },
    "requirements": {
      "$comment": "Each expected ID occurs exactly once; uniqueItems would compare entire objects, not their ID fields. Reordering is permitted. Metadata validity never grants human or operational approval.",
      "type": "array", "minItems": 30, "maxItems": 30,
      "items": {"$ref": "#/$defs/requirement"},
      "allOf": [
        {"contains": {"required": ["id"], "properties": {"id": {"const": "GOV-META-01"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "GOV-ENG-01"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "GOV-ENG-02"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "GOV-HUMAN-01"}}}, "minContains": 1, "maxContains": 1},
