        {"contains": {"required": ["id"], "properties": {"id": {"const": "GOV-AUDIT-01"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "GOV-HIDDEN-01"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "GOV-FAMILY-01"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "GOV-REVIEW-01"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "GOV-STORAGE-01"}}}, "minContains": 1, "maxContains": 1},
