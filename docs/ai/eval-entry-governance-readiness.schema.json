    "baseline_commit": {"$ref": "#/$defs/git_sha"},
    "mode": {"const": "METADATA_ONLY_GOVERNANCE_SNAPSHOT"},
    "overall_state": {"const": "BLOCKED"},
    "official_evaluation_authorized": {"const": false},
