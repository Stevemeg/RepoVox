        }}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["family_id", "repository", "commit_sha", "preliminary_language", "declared_license", "declared_license_sha256"], "properties": {
          "family_id": {"const": "sindresorhus-is"}, "repository": {"const": "sindresorhus/is"},
          "commit_sha": {"const": "e9c026c611c1160eaad50da00be4e676b626018f"}, "preliminary_language": {"const": "javascript_typescript"},
          "declared_license": {"const": "MIT"}, "declared_license_sha256": {"const": "5c932d88256b4ab958f64a856fa48e8bd1f55bc1d96b8149c65689e0c61789d3"}
        }}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["family_id", "repository", "commit_sha", "preliminary_language", "declared_license", "declared_license_sha256"], "properties": {
          "family_id": {"const": "sindresorhus-p-limit"}, "repository": {"const": "sindresorhus/p-limit"},
          "commit_sha": {"const": "a8a6fbec4e0e866d6d779b10889bb4f5567e70eb"}, "preliminary_language": {"const": "javascript_typescript"},
          "declared_license": {"const": "MIT"}, "declared_license_sha256": {"const": "5c932d88256b4ab958f64a856fa48e8bd1f55bc1d96b8149c65689e0c61789d3"}
        }}, "minContains": 1, "maxContains": 1},
