{
  "$defs": {
    "CanonicalFact": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "syntax",
            "relationship",
            "entrypoint"
          ],
          "title": "Category",
          "type": "string"
        },
        "classification": {
          "enum": [
            "declared",
            "resolved_static",
            "unresolved",
            "inferred"
          ],
          "title": "Classification",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "entrypoint_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint Category"
        },
        "entrypoint_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint Target"
        },
        "parser_rules": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Parser Rules",
          "type": "array"
        },
        "relationship": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "schema_version": {
          "const": "source-fact-2.0",
          "default": "source-fact-2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/SemanticSymbol"
        },
        "support": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Support",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticSymbol"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "category",
        "classification",
        "commit_sha",
        "parser_rules",
        "repository",
        "schema_version",
        "subject",
        "support"
      ],
      "title": "CanonicalFact",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "start_line",
        "end_line"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Judgment": {
      "additionalProperties": false,
      "properties": {
        "evidence_entailment": {
          "enum": [
            "supported",
            "unsupported",
            "unreviewed"
          ],
          "title": "Evidence Entailment",
          "type": "string"
        },
        "expected_status": {
          "enum": [
            "verified",
            "inferred",
            "documentation_only",
            "unsupported",
            "unreviewed"
          ],
          "title": "Expected Status",
          "type": "string"
        },
        "fact": {
          "$ref": "#/$defs/CanonicalFact"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fact",
        "expected_status",
        "evidence_entailment",
        "rationale"
      ],
      "title": "Judgment",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Assertion",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Window"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "evaluation": {
          "const": "SEMANTIC REVIEW REQUIRED",
          "default": "SEMANTIC REVIEW REQUIRED",
          "title": "Evaluation",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "inferred",
            "documentation_only",
            "unsupported",
            "unreviewed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "assertion",
        "status",
        "citations"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "independently_human_reviewed": {
          "const": false,
          "default": false,
          "title": "Independently Human Reviewed",
          "type": "boolean"
        },
        "official_eval_entry_contribution": {
          "const": false,
          "default": false,
          "title": "Official Eval Entry Contribution",
          "type": "boolean"
        },
        "production_certification": {
          "const": false,
          "default": false,
          "title": "Production Certification",
          "type": "boolean"
        },
        "track": {
          "const": "AI_AUDITED_EXPLORATORY",
          "default": "AI_AUDITED_EXPLORATORY",
          "title": "Track",
          "type": "string"
        },
        "training_authorized": {
          "const": false,
          "default": false,
          "title": "Training Authorized",
          "type": "boolean"
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "author_role": {
          "enum": [
            "INDEPENDENT_AI_TECHNICAL_REVIEWER",
            "SYNTHETIC_TEST_AUTHOR"
          ],
          "title": "Author Role",
          "type": "string"
        },
        "identity_basis": {
          "enum": [
            "owner_attested",
            "synthetic_fixture"
          ],
          "title": "Identity Basis",
          "type": "string"
        },
        "provider_authenticated": {
          "const": false,
          "default": false,
          "title": "Provider Authenticated",
          "type": "boolean"
        },
        "response_capture_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Response Capture Sha256",
          "type": "string"
        },
        "source_only_attestation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Only Attestation Sha256",
          "type": "string"
        }
      },
      "required": [
        "author_role",
        "source_only_attestation_sha256",
        "response_capture_sha256",
        "identity_basis"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SemanticSymbol": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alias"
        },
        "binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "constructor": {
          "default": false,
          "title": "Constructor",
          "type": "boolean"
        },
        "default_export": {
          "default": false,
          "title": "Default Export",
          "type": "boolean"
        },
        "dispatch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispatch"
        },
        "end_byte": {
          "minimum": 0,
          "title": "End Byte",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "exported": {
          "default": false,
          "title": "Exported",
          "type": "boolean"
        },
        "file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "import_module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Import Module"
        },
        "imported_member": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imported Member"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "local_binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Binding"
        },
        "parameters": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "qualified_name": {
          "title": "Qualified Name",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "start_byte": {
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "type_only": {
          "default": false,
          "title": "Type Only",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "start_line",
        "end_line",
        "start_byte",
        "end_byte",
        "category",
        "language",
        "source_name",
        "qualified_name"
      ],
      "title": "SemanticSymbol",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end_byte": {
          "minimum": 0,
          "title": "End Byte",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_byte": {
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "start_line",
        "end_line",
        "start_byte",
        "end_byte"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$id": "https://repovox.invalid/contracts/gold-evaluation-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_scope": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Annotation Scope",
      "type": "string"
    },
    "assertions": {
      "items": {
        "$ref": "#/$defs/Judgment"
      },
      "maxItems": 20000,
      "title": "Assertions",
      "type": "array"
    },
    "blind_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Blind Source Sha256",
      "type": "string"
    },
    "commit_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "correction_approval_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correction Approval Sha256"
    },
    "correction_citations": {
      "items": {
        "$ref": "#/$defs/Window"
      },
      "title": "Correction Citations",
      "type": "array"
    },
    "correction_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Correction Reason"
    },
    "family_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
      "title": "Family Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "maxItems": 1000,
      "title": "Observations",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "prediction_commitment_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Prediction Commitment Sha256",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "repository": {
      "title": "Repository",
      "type": "string"
    },
    "revision": {
      "maximum": 100,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "revision_context": {
      "default": "initial_blind",
      "enum": [
        "initial_blind",
        "source_only_correction",
        "post_reveal_correction"
      ],
      "title": "Revision Context",
      "type": "string"
    },
    "schema_version": {
      "const": "gold-evaluation-2.0",
      "default": "gold-evaluation-2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_description": {
      "minLength": 1,
      "title": "Scope Description",
      "type": "string"
    },
    "scope_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scope Sha256",
      "type": "string"
    },
    "supersedes_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes Sha256"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "annotation_scope",
    "assertions",
    "blind_source_sha256",
    "commit_sha",
    "correction_citations",
    "correction_reason",
    "family_id",
    "limitations",
    "observations",
    "policy",
    "prediction_commitment_sha256",
    "provenance",
    "repository",
    "revision",
    "schema_version",
    "scope_description",
    "scope_sha256",
    "supersedes_sha256",
    "tenant_id"
  ],
  "title": "Reference",
  "type": "object"
}
