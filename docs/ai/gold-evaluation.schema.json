      },
      "required": [
        "source",
        "target",
        "relationship",
        "classification",
        "support",
        "id",
        "supported",
        "citations"
      ],
      "title": "GoldEdge",
      "type": "object"
    },
    "GoldEntrypoint": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "rule": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
