        },
        "file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "kind": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "name": {
          "maxLength": 1024,
