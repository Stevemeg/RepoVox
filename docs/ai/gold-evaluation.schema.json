  "$id": "https://repovox.invalid/contracts/gold-evaluation/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_scope": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Annotation Scope",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/GoldClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "commit_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GoldEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "entrypoints": {
      "items": {
        "$ref": "#/$defs/GoldEntrypoint"
      },
      "title": "Entrypoints",
      "type": "array"
    },
    "gold_schema_version": {
      "const": "gold-evaluation-1.0",
      "title": "Gold Schema Version",
      "type": "string"
    },
    "repository": {
      "minLength": 1,
      "title": "Repository",
      "type": "string"
    },
    "safety_observations": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Safety Observations",
      "type": "object"
    },
    "symbols": {
      "items": {
        "$ref": "#/$defs/GoldSymbol"
      },
      "title": "Symbols",
      "type": "array"
    }
  },
  "required": [
    "gold_schema_version",
    "repository",
    "commit_sha",
    "annotation_scope",
    "symbols",
    "entrypoints",
    "edges",
    "claims",
    "safety_observations"
  ],
