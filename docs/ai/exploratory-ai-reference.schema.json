{
  "$defs": {
    "Attributes": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alias"
        },
        "binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding"
        },
        "dispatch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispatch"
        },
        "imported_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imported Name"
        },
        "parameters": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        }
      },
      "title": "Attributes",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "start_line",
        "end_line"
      ],
      "title": "Citation",
      "type": "object"
    },
    "EdgeFact": {
      "additionalProperties": false,
      "properties": {
        "edge": {
          "$ref": "#/$defs/EdgeIdentity"
        },
        "type": {
          "const": "static_relationship",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "edge"
      ],
      "title": "EdgeFact",
      "type": "object"
    },
    "EdgeIdentity": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "declared",
            "resolved_static",
            "unresolved",
            "inferred"
          ],
          "title": "Classification",
          "type": "string"
        },
        "relationship": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Relationship",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SymbolIdentity"
        },
        "support": {
          "items": {
            "$ref": "#/$defs/SymbolIdentity"
          },
          "minItems": 1,
          "title": "Support",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/SymbolIdentity"
        }
      },
      "required": [
        "source",
        "target",
        "relationship",
        "classification",
        "support"
      ],
      "title": "EdgeIdentity",
      "type": "object"
    },
    "GoldClaim": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "fact": {
          "discriminator": {
            "mapping": {
              "static_relationship": "#/$defs/EdgeFact",
              "symbol_syntax": "#/$defs/SymbolFact"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SymbolFact"
            },
            {
              "$ref": "#/$defs/EdgeFact"
            }
          ],
          "title": "Fact"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "inferred",
            "documentation_only",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "status",
        "fact",
        "citations"
      ],
      "title": "GoldClaim",
      "type": "object"
    },
