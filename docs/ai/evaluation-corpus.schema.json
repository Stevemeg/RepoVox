          "oneOf": [
            {
              "$ref": "#/$defs/SymbolFact"
            },
            {
              "$ref": "#/$defs/EdgeFact"
            }
          ],
          "title": "Fact"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "inferred",
            "documentation_only",
            "unsupported"
          ],
