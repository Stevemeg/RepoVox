        "symbols": {
          "items": {
            "$ref": "#/$defs/GoldSymbol"
          },
          "title": "Symbols",
          "type": "array"
        },
        "withdrawn": {
          "default": false,
          "title": "Withdrawn",
          "type": "boolean"
        }
