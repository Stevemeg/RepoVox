        "content_fingerprints": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Content Fingerprints",
          "type": "array"
        },
        "derivatives": {
          "items": {
            "type": "string"
