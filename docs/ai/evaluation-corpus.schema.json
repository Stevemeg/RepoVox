        "source_manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Manifest Sha256",
          "type": "string"
        },
        "split": {
          "enum": [
            "TOOLING_FIXTURE",
            "EVAL_DEV",
            "EVAL_TEST"
