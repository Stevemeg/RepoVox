      "type": "object"
    },
    "EdgeFact": {
      "additionalProperties": false,
      "properties": {
        "edge": {
          "$ref": "#/$defs/EdgeIdentity"
        },
        "type": {
          "const": "static_relationship",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "edge"
      ],
      "title": "EdgeFact",
      "type": "object"
    },
    "EdgeIdentity": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "declared",
            "resolved_static",
            "unresolved",
            "inferred"
          ],
          "title": "Classification",
          "type": "string"
        },
        "relationship": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Relationship",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SymbolIdentity"
        },
        "support": {
          "items": {
            "$ref": "#/$defs/SymbolIdentity"
          },
          "minItems": 1,
          "title": "Support",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/SymbolIdentity"
        }
