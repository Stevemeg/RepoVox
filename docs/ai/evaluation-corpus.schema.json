        "commit_sha",
        "annotation_scope",
        "symbols",
        "entrypoints",
        "edges",
        "claims",
        "safety_observations",
        "id",
        "language_slice",
        "split",
        "hidden",
        "newly_owner_authored",
        "derivatives",
